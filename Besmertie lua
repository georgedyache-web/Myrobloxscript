-- ЛОГИКА: ПОЛЕТ (FLY)
local flying = false
local flySpeed = 50
local player = game:GetService("Players").LocalPlayer

ToggleFly.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        ToggleFly.Text = "Полет (Fly): ВКЛ"
        ToggleFly.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        task.spawn(function()
            local char = player.Character or player.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart")
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FlyVelocity"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(100000, 100000, 100000)
            bv.Parent = root
            local camera = workspace.CurrentCamera
            while flying do
                pcall(function()
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local moveDir = hum.MoveDirection
                    if moveDir.Magnitude > 0 then
                        bv.Velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X * flySpeed, 0, moveDir.Z * -flySpeed))
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end
                end)
                task.wait()
            end
            bv:Destroy()
        end)
    else
        ToggleFly.Text = "Полет (Fly): ВЫКЛ"
        ToggleFly.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

-- ЛОГИКА: БЕССМЕРТИЕ (LOOP HEAL)
local godActive = false
ToggleGod.MouseButton1Click:Connect(function()
    godActive = not godActive
    if godActive then
        ToggleGod.Text = "Бессмертие (Loop Heal): ВКЛ"
        ToggleGod.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        task.spawn(function()
            while godActive do
                pcall(function()
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        hum.Health = hum.MaxHealth
                    end
                end)
                task.wait(0.05)
            end
        end)
    else
        ToggleGod.Text = "Бессмертие (Loop Heal): ВЫКЛ"
        ToggleGod.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

-- ЛОГИКА: МНОГОКРАТНОЕ УДАЛЕНИЕ ЛОВУШЕК
local autoClearActive = false
ToggleKillZones.MouseButton1Click:Connect(function()
    autoClearActive = not autoClearActive
    if autoClearActive then
        ToggleKillZones.Text = "Авто-удаление ловушек: ВКЛ"
        ToggleKillZones.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        task.spawn(function()
            while autoClearActive do
                pcall(function()
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("TouchTransmitter") or obj.Name == "TouchInterest" then
                            obj:Destroy()
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    else
        ToggleKillZones.Text = "Авто-удаление ловушек: ВЫКЛ"
        ToggleKillZones.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)
