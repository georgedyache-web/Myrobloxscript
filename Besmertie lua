-- ПОЛЕТ
local flying = false
local flySpeed = 50
ToggleFly.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        ToggleFly.Text = "Полет (Fly): ВКЛ"
        ToggleFly.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        task.spawn(function()
            local char = player.Character or player.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart")
            local bv = Instance.new("BodyVelocity", root)
            bv.Name = "FlyVelocity"
            bv.MaxForce = Vector3.new(100000, 100000, 100000)
            local camera = workspace.CurrentCamera
            while flying do
                pcall(function()
                    local moveDir = char:FindFirstChildOfClass("Humanoid").MoveDirection
                    if moveDir.Magnitude > 0 then
                        bv.Velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X * flySpeed, 0, moveDir.Z * -flySpeed))
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end
                end)
                task.wait()
            end
            bv:Destroy()
        end)
    else
        ToggleFly.Text = "Полет (Fly): ВЫКЛ"
        ToggleFly.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

-- СКВОЗЬ СТЕНЫ (NOCLIP)
local noclipActive = false
ToggleNoclip.MouseButton1Click:Connect(function()
    noclipActive = not noclipActive
    if noclipActive then
        ToggleNoclip.Text = "Сквозь стены (Noclip): ВКЛ"
        ToggleNoclip.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    else
        ToggleNoclip.Text = "Сквозь стены (Noclip): ВЫКЛ"
        ToggleNoclip.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

game:GetService("RunService").Stepped:Connect(function()
    if noclipActive then
        pcall(function()
            local char = player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end)

-- РАБОЧЕЕ БЕССМЕРТИЕ
ToggleGod.MouseButton1Click:Connect(function()
    pcall(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            local clone = hum:Clone()
            hum:Destroy()
            clone.Parent = char
            ToggleGod.Text = "БЕССМЕРТИЕ АКТИВИРОВАНО"
            ToggleGod.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        end
    end)
end)

-- АВТО-УДАЛЕНИЕ ЛОВУШЕК
local autoClearActive = false
ToggleKillZones.MouseButton1Click:Connect(function()
    autoClearActive = not autoClearActive
    if autoClearActive then
        ToggleKillZones.Text = "Авто-удаление ловушек: ВКЛ"
        ToggleKillZones.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        task.spawn(function()
            while autoClearActive do
                pcall(function()
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("TouchTransmitter") or obj.Name == "TouchInterest" then
                            obj:Destroy()
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    else
        ToggleKillZones.Text = "Авто-удаление ловушек: ВЫКЛ"
        ToggleKillZones.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)
