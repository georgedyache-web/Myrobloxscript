ToggleFly.TextSize = 15
ToggleFly.Font = Enum.Font.SourceSansBold

-- Логика полета (совместимая с мобильными и ПК)
local flying = false
local speed = 50 
local player = game:GetService("Players").LocalPlayer

ToggleFly.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        ToggleFly.Text = "Полет (Fly): ВКЛ"
        ToggleFly.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        
        task.spawn(function()
            local char = player.Character or player.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart")
            
            -- Создаем физический объект для удержания в воздухе
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FlyVelocity"
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(100000, 100000, 100000)
            bv.Parent = root
            
            local camera = workspace.CurrentCamera
            
            while flying do
                pcall(function()
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    -- Направление движения зависит от того, куда смотрит камера
                    local moveDir = hum.MoveDirection
                    
                    if moveDir.Magnitude > 0 then
                        bv.Velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X * speed, 0, moveDir.Z * -speed))
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end
                end)
                task.wait()
            end
            bv:Destroy()
        end)
    else
        ToggleFly.Text = "Полет (Fly): ВЫКЛ"
        ToggleFly.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)
